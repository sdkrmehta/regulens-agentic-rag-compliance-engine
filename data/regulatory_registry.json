      "circular_number": "RBI/DBR/2015-16/18 (Master Direction DBR.AML.BC.No.81/14.01.001/2015-16)",
      "publication_date": "2016-02-25",
      "effective_date": "2016-02-25",
      "amendment_date": "2024-01-04",
      "superseded_date": null,
      "document_status": "ACTIVE",
      "version": "Updated as on January 04, 2024",
      "source_url": "https://www.rbi.org.in/Scripts/BS_ViewMasDirections.aspx?id=11566",
      "source_type": "official_gazette",
      "source_hash": "f4c3b2a198fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b899",
      "downloaded_at": "2026-11-09T00:00:00Z",
      "last_verified_at": "2026-11-12T00:00:00Z",
      "notes": "Master Direction governing AML/CFT and Customer Due Diligence. Key provisions include Clause 38 periodic KYC update intervals (2 years for High Risk, 8 years for Medium Risk, 10 years for Low Risk); Sections 18 & 27 V-CIP technical requirements (live video session, liveness detection, geotagging within India, OTP/Aadhaar verification); PEP onboarding senior management approval; and Officially Valid Document (OVD) rules."
    },
